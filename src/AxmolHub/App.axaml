<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AxmolHub.App"
             Name="Axmol Hub"
             RequestedThemeVariant="Default">

  <!-- Default follows the system theme. The WPF version only had the dark theme; light was added in P3
       (see ThemeDictionaries in HubTokens.axaml), so the same window is no longer black-backed under the
       Windows / macOS light environment. To force a variant, change Application.Current.RequestedThemeVariant
       at runtime — that's what the control gallery does.

       This value is only the XAML initial value: at startup ThemeService.Apply overwrites it with the
       user's choice from the settings page (system / light / dark), and the settings page writes it
       back on every change. -->

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Order matters: the control theme references icons and colors, so it must come after them. -->
        <ResourceInclude Source="avares://AxmolHub/Theme/HubTokens.axaml" />
        <ResourceInclude Source="avares://AxmolHub/Theme/HubIcons.axaml" />
        <!-- Metrics are theme-independent and referenced by the control theme's frames, so they load with the
             other dictionaries rather than as a Style. -->
        <ResourceInclude Source="avares://AxmolHub/Theme/HubMetrics.axaml" />
        <ResourceInclude Source="avares://AxmolHub/Theme/HubControls.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <!-- DataGrid's Fluent theme lives in a separate NuGet package and must be included explicitly.
         Placed before HubStyles: the DataGrid styles in HubStyles need to override on top of it. -->
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://AxmolHub/Theme/HubStyles.axaml" />
  </Application.Styles>

  <!-- macOS reads the application menu from here; with no menu of Hub's own the framework exports one whose
       About entry opens Avalonia's About dialog (docs.avaloniaui.net/docs/platform-specific-guides/macos
       #application-menu). On macOS the items exported here are the application menu's own items — the exporter
       appends the standard Services / Hide / Show All / Quit entries after them — so the About entry is a plain
       top-level item: a menu of Hub's own inside the application menu would add a second level for one row.
       Windows and Linux have no exporter to read this: the object graph exists on all three hosts, which is
       what the shell self-check reads.

       The header is a literal, not {DynamicResource}: a NativeMenuItem is not in the visual or logical tree, so
       a resource reference there has no lookup chain and would render blank with no error. The product's name
       is the same in both UI languages, so nothing is lost — only the dialog's button is copy that follows the
       language setting (it comes from HubTexts). -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="About Axmol Hub…" Click="OnAboutMenuClick" />
    </NativeMenu>
  </NativeMenu.Menu>

</Application>
