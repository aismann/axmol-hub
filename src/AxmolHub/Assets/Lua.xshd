<SyntaxDefinition name="Lua" extensions=".lua"
                  xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#7F8799" />
  <Color name="Keyword" foreground="#F7768E" fontWeight="bold" />
  <Color name="String" foreground="#7DCFFF" />
  <Color name="Number" foreground="#BB9AF7" />
  <RuleSet>
    <!-- Long comments and long strings first: a "[" or "-" span declared before them would win the position. -->
    <Span color="Comment" begin="--\[\[" end="\]\]" />
    <Span color="Comment" begin="--" />
    <Span color="String" begin="\[\[" end="\]\]" />
    <Span color="String" begin="&quot;" end="&quot;" />
    <Span color="String" begin="'" end="'" />
    <Rule color="Number">\b(0x[0-9a-fA-F]+|\d+(\.\d+)?([eE][+-]?\d+)?)\b</Rule>
    <Keywords color="Keyword">
      <Word>and</Word>
      <Word>break</Word>
      <Word>do</Word>
      <Word>else</Word>
      <Word>elseif</Word>
      <Word>end</Word>
      <Word>false</Word>
      <Word>for</Word>
      <Word>function</Word>
      <Word>goto</Word>
      <Word>if</Word>
      <Word>in</Word>
      <Word>local</Word>
      <Word>nil</Word>
      <Word>not</Word>
      <Word>or</Word>
      <Word>repeat</Word>
      <Word>return</Word>
      <Word>then</Word>
      <Word>true</Word>
      <Word>until</Word>
      <Word>while</Word>
    </Keywords>
  </RuleSet>
</SyntaxDefinition>
