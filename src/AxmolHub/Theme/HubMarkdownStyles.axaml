<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:ctxt="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia"
        x:Class="AxmolHub.HubMarkdownStyles">

  <!--
    Markdown document styling, from the Hub tokens.

    The reason this file exists at all: the GithubLike markdown theme hardcodes light-theme colors
    (black headings, LightGray inline code, white table cells, #DFE2E5 grid lines), and it is inserted
    at index 0 of the viewer's OWN Styles collection by MarkdownScrollViewer. For a control inside the
    rendered document that collection is closer than ChatPanel's, so it wins over anything written
    there, and a rule in ChatPanel.axaml that collides with a theme setter silently does nothing.
    Later index in the same collection is the only thing that beats it, which is what
    MarkdownMessageRenderer.Render sets up here.

    So: every rule about what the renderer draws lives in this file, not in ChatPanel.axaml. That
    includes the two controls the renderer builds itself — the code editor and its copy button —
    because the same renderer feeds the inspector's plan tab, which is not inside ChatPanel, and a
    rule written there reached only the chat half (the plan tab's copy button fell back to the base
    Button theme and showed no icon at all).
  -->

  <!-- Body text. The theme leaves Foreground alone but sets FontSize 14, so both belong here. -->
  <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CHyperlink">
    <Setter Property="Foreground" Value="{DynamicResource Hub.Link}" />
    <Setter Property="HoverForeground" Value="{DynamicResource Hub.LinkHover}" />
    <Setter Property="IsUnderline" Value="True" />
  </Style>

  <!--
    Headings: the theme's black is replaced, and the sizes are restated. Restating them is not
    duplication for its own sake: this file is the winning layer, so the base rule above would
    otherwise flatten every heading to body size, and Avalonia ranks styles by position rather than
    by specificity. Weights and margins are left to the theme because nothing here competes with them.
  -->
  <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.Heading1">
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    <Setter Property="FontSize" Value="28" />
  </Style>
  <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.Heading2">
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    <Setter Property="FontSize" Value="21" />
  </Style>
  <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.Heading3">
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    <Setter Property="FontSize" Value="17.5" />
  </Style>
  <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.Heading4">
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CCode">
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
  </Style>

  <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.CodeBlock">
    <Setter Property="Background" Value="{DynamicResource Hub.SurfaceSunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="0,10" />
  </Style>
  <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.CodeBlock:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderHover}" />
  </Style>
  <Style Selector=".Markdown_Avalonia_MarkdownViewer TextBlock.CodeBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Hub.Font.Mono}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
  </Style>

  <!-- The fenced block's editor and its copy button are built by MarkdownMessageRenderer in code
       (class names only, no Content), so both their chrome and the icon live here as a template. -->
  <Style Selector=".Markdown_Avalonia_MarkdownViewer ae|TextEditor.markdown-code-editor">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Hub.Font.Mono}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector=".Markdown_Avalonia_MarkdownViewer Button.markdown-code-copy">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="MinWidth" Value="22" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextSecondary}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Frame"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Path Width="15"
                Height="15"
                Stretch="Uniform"
                Data="{StaticResource Hub.Icon.Copy}"
                Fill="Transparent"
                Stroke="{TemplateBinding Foreground}"
                StrokeThickness="1.8" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector=".Markdown_Avalonia_MarkdownViewer Button.markdown-code-copy:pointerover">
    <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
  </Style>

  <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.Blockquote">
    <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
  </Style>

  <!-- GitHub alert blocks ("> [!NOTE]"): the theme paints them #FAFAFA with a #DEDEDE edge. -->
  <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.Note">
    <Setter Property="Background" Value="{DynamicResource Hub.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}" />
  </Style>

  <!-- Tables. The header band belongs on the cell, not on the text block: the theme's White box only
       covers the glyphs, which is what made the header look like a row of white chips. -->
  <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.Table">
    <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderStrong}" />
  </Style>

  <Style Selector=".Markdown_Avalonia_MarkdownViewer Grid.Table > Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderStrong}" />
  </Style>

  <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.TableHeader">
    <Setter Property="Background" Value="{DynamicResource Hub.SurfaceRaised}" />
  </Style>

  <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.TableHeader ctxt|CTextBlock">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
  </Style>

  <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.OddTableRow">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.EvenTableRow">
    <Setter Property="Background" Value="{DynamicResource Hub.SurfaceAlt}" />
  </Style>

  <Style Selector=".Markdown_Avalonia_MarkdownViewer Grid.Table ctxt|CTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Hub.TextPrimary}" />
  </Style>
</Styles>
