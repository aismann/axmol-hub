<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Semantic color vocabulary. The WPF version scattered these values as literals across the 18
    ControlTemplates in App.xaml (#1E1E1E / #E4E4E4 / #A8A8A8 …), with the same meaning written as
    different near-matching colors in different controls. Here each meaning appears exactly once;
    the control layer only references names, never writes literals.

    Theme variants are expressed with ThemeDictionaries: which variant the app runs under is decided
    by RequestedThemeVariant, and switching variants at runtime makes all DynamicResource references
    re-resolve automatically. The WPF version only had the dark theme.
  -->

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Dark">

      <SolidColorBrush x:Key="Hub.Background" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Hub.Surface" Color="#2E2E2E" />
      <SolidColorBrush x:Key="Hub.SurfaceAlt" Color="#242424" />
      <!-- The spine: sidebar and inspector column. In dark it sits *below* the reading page so the page
           reads as the forward surface and the spine recedes; in light it is a touch darker than the page,
           the macOS / ChatGPT convention. Separate from SurfaceAlt (the composer/log card) on purpose. -->
      <SolidColorBrush x:Key="Hub.SurfaceChrome" Color="#1A1A1A" />
      <SolidColorBrush x:Key="Hub.SurfaceRaised" Color="#353535" />
      <SolidColorBrush x:Key="Hub.SurfaceSunken" Color="#202020" />
      <SolidColorBrush x:Key="Hub.ProviderSurface" Color="#252525" />
      <SolidColorBrush x:Key="Hub.SurfaceHover" Color="#343434" />
      <SolidColorBrush x:Key="Hub.SurfaceSelected" Color="#383838" />
      <SolidColorBrush x:Key="Hub.PopupSurface" Color="#292929" />

      <SolidColorBrush x:Key="Hub.Border" Color="#3A3A3A" />
      <SolidColorBrush x:Key="Hub.BorderSubtle" Color="#353535" />
      <SolidColorBrush x:Key="Hub.BorderStrong" Color="#4B4B4B" />
      <SolidColorBrush x:Key="Hub.BorderHover" Color="#6AB6EB" />
      <SolidColorBrush x:Key="Hub.BorderFocus" Color="#399BDC" />

      <SolidColorBrush x:Key="Hub.TextPrimary" Color="#E4E4E4" />
      <!-- The reading rung: the ink a body of prose is read in, one step below the primary that chrome,
           headings and icons use. Primary was picked for labels and controls, and at #E4E4E4 on #1E1E1E it
           measures about 13:1 — right for a menu item, tiring for an answer somebody reads for minutes. The
           prose and the code sitting inside it take this rung instead, which is what makes the heading above a
           paragraph the brightest thing in it. It stays above AAA (7:1) on every surface it can land on:
           Background ≈10:1, SurfaceRaised (an inline code chip) ≈7.4:1, SurfaceSunken (a fenced block) ≈9.8:1.
           Headings deliberately keep Hub.TextPrimary — that difference is the reading hierarchy, so do not
           collapse the two rungs into one. -->
      <SolidColorBrush x:Key="Hub.TextBody" Color="#C9C9C9" />
      <SolidColorBrush x:Key="Hub.TextSecondary" Color="#A8A8A8" />
      <SolidColorBrush x:Key="Hub.TextTertiary" Color="#888888" />
      <SolidColorBrush x:Key="Hub.TextDisabled" Color="#7A7A7A" />
      <SolidColorBrush x:Key="Hub.TextOnAccent" Color="#FFFFFF" />

      <SolidColorBrush x:Key="Hub.Accent" Color="#2188CF" />
      <SolidColorBrush x:Key="Hub.AccentBorder" Color="#399BDC" />
      <SolidColorBrush x:Key="Hub.AccentSoft" Color="#2879CE" />
      <SolidColorBrush x:Key="Hub.AccentSoftBorder" Color="#398BE0" />
      <SolidColorBrush x:Key="Hub.Link" Color="#70B8F2" />
      <SolidColorBrush x:Key="Hub.LinkHover" Color="#9BCBFA" />

      <!-- Text selection on the reading surfaces (chat Markdown and the inspector's plan tab). A translucent
           accent rather than an opaque plate, so the ink under it keeps its own colour and a bold or code run
           stays legible the way it does in the reference shells: 45% of Hub.Accent over Hub.Background lands on
           #1F4E6E. Two tokens because the inline code chip paints an opaque surface of its own — a translucent
           brush set on the chip would composite against the selection band already beneath it and come out
           darker than the band around it, so Hub.SelectionChip is that same mix over Hub.SurfaceRaised, worked
           out here once instead of at paint time. The band itself is drawn by the library inside
           CTextBlock.Render, which fills it with SelectionBrush and falls back to Brushes.Cyan when no brush is
           set — that cyan is what the setter in HubMarkdownStyles replaces. -->
      <SolidColorBrush x:Key="Hub.Selection" Color="#732188CF" />
      <SolidColorBrush x:Key="Hub.SelectionChip" Color="#2C5A7A" />

      <SolidColorBrush x:Key="Hub.Success" Color="#70D7AF" />
      <SolidColorBrush x:Key="Hub.PreviewBadgeBackground" Color="#594313" />
      <SolidColorBrush x:Key="Hub.PreviewBadgeForeground" Color="#FFE08A" />
      <SolidColorBrush x:Key="Hub.PreviewBadgeBorder" Color="#80611F" />
      <SolidColorBrush x:Key="Hub.Danger" Color="#F294A7" />
      <!-- Danger split in two weights. Hub.Danger is a fill: on a dark page it is a bright block, which is
           why only HubDialog's confirm key uses it. Hub.DangerText is the same hue used as ink, and
           Hub.DangerBorder is that hue mixed into the surface, so a page button can be marked
           consequential without shouting over the action bar's primary button. -->
      <SolidColorBrush x:Key="Hub.DangerText" Color="#F294A7" />
      <SolidColorBrush x:Key="Hub.DangerBorder" Color="#8A5A64" />

      <!-- Alert red, and it is not a shade of Hub.Danger. Danger is a statement about an act ("this will do
           something you cannot undo"); this one is a statement about attention ("something here is waiting for
           you") — the taskbar badge's job, in the taskbar badge's pure saturated red. Used only by the sidebar's
           approval dot. -->
      <SolidColorBrush x:Key="Hub.AlertDot" Color="#FF0000" />

      <!-- Diff row tints for the inspector's changed-files view. The ink for a removed line is Hub.DangerText,
           which is ink and not a destructive button, so the "red is only for what runs unasked" rule is not in
           play here; these two are the row's floor. They must separate from Hub.SurfaceAlt in both variants —
           a tint that equals its surface is a tint nobody can see, which is exactly how the light-theme
           SurfaceRaised/SurfaceAlt bug looked. -->
      <SolidColorBrush x:Key="Hub.DiffAddSurface" Color="#1F3A32" />
      <SolidColorBrush x:Key="Hub.DiffDeleteSurface" Color="#3A2A2E" />

      <SolidColorBrush x:Key="Hub.GridSurface" Color="#252525" />
      <SolidColorBrush x:Key="Hub.GridAlternate" Color="#292929" />
      <SolidColorBrush x:Key="Hub.GridHeader" Color="#2D2D2D" />
      <SolidColorBrush x:Key="Hub.RowHover" Color="#313131" />
      <SolidColorBrush x:Key="Hub.RowSelected" Color="#3B3B3B" />

      <SolidColorBrush x:Key="Hub.ScrollTrack" Color="#202020" />
      <SolidColorBrush x:Key="Hub.ScrollThumb" Color="#575757" />
      <SolidColorBrush x:Key="Hub.ScrollThumbHover" Color="#6E6E6E" />

      <SolidColorBrush x:Key="Hub.CheckBoxFill" Color="#2B2B2B" />
      <SolidColorBrush x:Key="Hub.CheckBoxBorder" Color="#4B4B4B" />
      <SolidColorBrush x:Key="Hub.CheckMark" Color="#FFFFFF" />

      <!-- ==================== Brand mark ====================
           The app icon's own gradient, for the sidebar title block's mark (Hub.Image.Brand). Deliberately not
           Hub.Accent: the brand is a fixed identity that must not move when a theme or an accent changes, and
           on a light background the source icon's violet end needs one step less saturation to sit on white.
           Hub.BrandCore is the pale core disc; the sparkle is cut out of it by even-odd, so this is the ink
           that shows through the cutout. -->
      <LinearGradientBrush x:Key="Hub.BrandGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#A845D8" />
        <GradientStop Offset="0.5" Color="#6470EE" />
        <GradientStop Offset="1" Color="#3EC8F5" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="Hub.BrandCore" Color="#9FE8FF" />

      <!-- ==================== Title bar ====================
           The window's own title bar (this app draws it: ExtendClientAreaToDecorationsHint). It takes
           Hub.Background rather than a surface of its own, because the bar has no content of its own to sit
           above — it is the same plane as the page, separated by the one hairline. One subtle hairline
           rather than Hub.Border, so the bar reads as the window's edge and not as a toolbar. -->
      <SolidColorBrush x:Key="Hub.TitleBarBackground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Hub.TitleBarBorder" Color="#353535" />
      <!-- The three caption plates. Hover/pressed follow the platform convention (a plain neutral wash) and the
           close plate is the one exception it always is: nothing else may turn red, and this must. -->
      <SolidColorBrush x:Key="Hub.WindowButtonHover" Color="#343434" />
      <SolidColorBrush x:Key="Hub.WindowButtonPressed" Color="#4A4A4A" />
      <SolidColorBrush x:Key="Hub.WindowButtonCloseHover" Color="#C42B1C" />
      <SolidColorBrush x:Key="Hub.WindowButtonCloseForeground" Color="#FFFFFF" />

    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">

      <!-- Light is not the inverse of dark but a separately chosen set of values: cards are brighter
           than the page (white), and the sidebar is slightly darker than the page, matching the
           light-theme conventions of macOS / Windows. -->
      <SolidColorBrush x:Key="Hub.Background" Color="#F4F5F7" />
      <SolidColorBrush x:Key="Hub.Surface" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Hub.SurfaceAlt" Color="#EDEEF2" />
      <SolidColorBrush x:Key="Hub.SurfaceChrome" Color="#E8E9ED" />
      <!-- A light theme has nowhere above white to lift a surface, so "raised" here means "one step above the well
           it sits in": the chips and attachment pills live on SurfaceAlt (the composer), and the value below was
           within five levels of it — a chip that was there and could not be seen. The border each of them draws is
           what carries the edge in this variant. -->
      <SolidColorBrush x:Key="Hub.SurfaceRaised" Color="#F8F9FB" />
      <SolidColorBrush x:Key="Hub.SurfaceSunken" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Hub.ProviderSurface" Color="#EEF0F4" />
      <SolidColorBrush x:Key="Hub.SurfaceHover" Color="#E4E4EA" />
      <SolidColorBrush x:Key="Hub.SurfaceSelected" Color="#DCE4F0" />
      <SolidColorBrush x:Key="Hub.PopupSurface" Color="#FFFFFF" />

      <SolidColorBrush x:Key="Hub.Border" Color="#D8D9DF" />
      <SolidColorBrush x:Key="Hub.BorderSubtle" Color="#E4E5EA" />
      <SolidColorBrush x:Key="Hub.BorderStrong" Color="#C3C4CC" />
      <SolidColorBrush x:Key="Hub.BorderHover" Color="#4FA8E8" />
      <SolidColorBrush x:Key="Hub.BorderFocus" Color="#1A73BE" />

      <SolidColorBrush x:Key="Hub.TextPrimary" Color="#1B1C20" />
      <!-- Light counterpart of the reading rung; see the Dark dictionary's note. Light has nowhere darker than
           the primary to go, so one step toward the page's own grey is all this can be: ≈13:1 on
           Hub.Background, still the brightest ink in a message after its headings. -->
      <SolidColorBrush x:Key="Hub.TextBody" Color="#2A2B31" />
      <SolidColorBrush x:Key="Hub.TextSecondary" Color="#6A6B75" />
      <SolidColorBrush x:Key="Hub.TextTertiary" Color="#8A8B95" />
      <SolidColorBrush x:Key="Hub.TextDisabled" Color="#A6A7B0" />
      <SolidColorBrush x:Key="Hub.TextOnAccent" Color="#FFFFFF" />

      <SolidColorBrush x:Key="Hub.Accent" Color="#1A73BE" />
      <SolidColorBrush x:Key="Hub.AccentBorder" Color="#2E86C8" />
      <SolidColorBrush x:Key="Hub.AccentSoft" Color="#2E86C8" />
      <SolidColorBrush x:Key="Hub.AccentSoftBorder" Color="#3D93D6" />
      <SolidColorBrush x:Key="Hub.Link" Color="#1769AA" />
      <SolidColorBrush x:Key="Hub.LinkHover" Color="#0E4F88" />

      <!-- Light counterparts; see the Dark dictionary's note for what the pair is for. Same 45% of Hub.Accent,
           which over this page's #F4F5F7 lands on #92BBDD, and the chip's opaque mix over #F8F9FB. -->
      <SolidColorBrush x:Key="Hub.Selection" Color="#731A73BE" />
      <SolidColorBrush x:Key="Hub.SelectionChip" Color="#94BDE0" />

      <SolidColorBrush x:Key="Hub.Success" Color="#1E9E76" />
      <SolidColorBrush x:Key="Hub.PreviewBadgeBackground" Color="#FFF1BF" />
      <SolidColorBrush x:Key="Hub.PreviewBadgeForeground" Color="#664D00" />
      <SolidColorBrush x:Key="Hub.PreviewBadgeBorder" Color="#E5C75C" />
      <SolidColorBrush x:Key="Hub.Danger" Color="#C63A55" />
      <SolidColorBrush x:Key="Hub.DangerText" Color="#C63A55" />
      <SolidColorBrush x:Key="Hub.DangerBorder" Color="#E5A6B2" />
      <!-- The badge red on light, the same pure red as the Dark dictionary's Hub.AlertDot — one signal, one
           colour, in both variants. See that note for why it is not a shade of Hub.Danger. -->
      <SolidColorBrush x:Key="Hub.AlertDot" Color="#FF0000" />

      <!-- Light counterparts of the diff row tints; see the Dark dictionary's note. Light has nowhere above
           white to go, so both sit clearly below Hub.SurfaceAlt (#EDEEF2) instead of above it. -->
      <SolidColorBrush x:Key="Hub.DiffAddSurface" Color="#D9EFE4" />
      <SolidColorBrush x:Key="Hub.DiffDeleteSurface" Color="#F6DFE5" />

      <SolidColorBrush x:Key="Hub.GridSurface" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Hub.GridAlternate" Color="#FAFAFC" />
      <SolidColorBrush x:Key="Hub.GridHeader" Color="#F0F1F4" />
      <SolidColorBrush x:Key="Hub.RowHover" Color="#EFF2F7" />
      <SolidColorBrush x:Key="Hub.RowSelected" Color="#DCE8F5" />

      <SolidColorBrush x:Key="Hub.ScrollTrack" Color="#EFEFF2" />
      <SolidColorBrush x:Key="Hub.ScrollThumb" Color="#B9BAC2" />
      <SolidColorBrush x:Key="Hub.ScrollThumbHover" Color="#9A9BA4" />

      <SolidColorBrush x:Key="Hub.CheckBoxFill" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Hub.CheckBoxBorder" Color="#B9BAC4" />
      <SolidColorBrush x:Key="Hub.CheckMark" Color="#FFFFFF" />

      <!-- Light counterparts; see the Dark dictionary's note for what each one is for. The brand gradient is
           one stop less saturated at its violet end so the mark keeps its contrast on a white sidebar. -->
      <LinearGradientBrush x:Key="Hub.BrandGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#9530C6" />
        <GradientStop Offset="0.5" Color="#4E5CDD" />
        <GradientStop Offset="1" Color="#1FA8D8" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="Hub.BrandCore" Color="#1B8FC4" />

      <!-- The title bar is white here rather than Hub.Background: on light, the page's plane is a near-white
           with no card under the bar, and a bar one step *above* the page is what the platform does. -->
      <SolidColorBrush x:Key="Hub.TitleBarBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Hub.TitleBarBorder" Color="#E4E5EA" />
      <SolidColorBrush x:Key="Hub.WindowButtonHover" Color="#E8E9EE" />
      <SolidColorBrush x:Key="Hub.WindowButtonPressed" Color="#D8D9E0" />
      <SolidColorBrush x:Key="Hub.WindowButtonCloseHover" Color="#C42B1C" />
      <SolidColorBrush x:Key="Hub.WindowButtonCloseForeground" Color="#FFFFFF" />

    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
